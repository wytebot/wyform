# Firebase Auth (Google sign-in) — client config is hardcoded in src/lib/firebase.js,
# no VITE_FIREBASE_* variables are needed.

# Firebase Admin (server-side token verification)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth for Gmail + Sheets + Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://formback.ng/api/google-callback
OAUTH_ENCRYPTION_KEY=generate-a-long-random-secret
CRON_SECRET=another-long-random-secret

# App
APP_URL=https://formback.ng

# Paystack
PAYSTACK_SECRET_KEY=

# Flutterwave v4 OAuth/API
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_API_BASE_URL=https://f4bexperience.flutterwave.com
FLW_SECRET_HASH=
