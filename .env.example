# Firebase Auth (Google sign-in) — client config is hardcoded in src/lib/firebase.js.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth for Gmail + Sheets + Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud.
# If omitted, WyForm derives it as ${APP_URL}/api/google-callback.
GOOGLE_REDIRECT_URI=
# Use a long random secret (32+ characters).
OAUTH_ENCRYPTION_KEY=
CRON_SECRET=

# Public production origin. HTTPS required.
APP_URL=https://your-domain.example

# Paystack
PAYSTACK_SECRET_KEY=

# Flutterwave v4 OAuth/API
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_API_BASE_URL=https://f4bexperience.flutterwave.com
FLW_SECRET_HASH=
