{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/forms-public",
      "destination": "/api/forms?route=forms-public"
    },
    {
      "source": "/api/form-submission",
      "destination": "/api/forms?route=form-submission"
    },
    {
      "source": "/api/form-stats",
      "destination": "/api/forms?route=form-stats"
    },
    {
      "source": "/api/google-auth",
      "destination": "/api/google?route=google-auth"
    },
    {
      "source": "/api/google-callback",
      "destination": "/api/google?route=google-callback"
    },
    {
      "source": "/api/google-token",
      "destination": "/api/google?route=google-token"
    },
    {
      "source": "/api/google-drive",
      "destination": "/api/google?route=google-drive"
    },
    {
      "source": "/api/gmail-status",
      "destination": "/api/google?route=gmail-status"
    },
    {
      "source": "/api/sheets-sync",
      "destination": "/api/google?route=sheets-sync"
    },
    {
      "source": "/api/billing-status",
      "destination": "/api/billing?route=billing-status"
    },
    {
      "source": "/api/flutterwave-v4",
      "destination": "/api/billing?route=flutterwave-v4"
    },
    {
      "source": "/api/paystack-webhook",
      "destination": "/api/webhooks?route=paystack-webhook"
    },
    {
      "source": "/api/flutterwave-webhook",
      "destination": "/api/webhooks?route=flutterwave-webhook"
    },
    {
      "source": "/api/process-delivery-jobs",
      "destination": "/api/jobs?route=process-delivery-jobs"
    },
    {
      "source": "/api/maintenance",
      "destination": "/api/jobs?route=maintenance"
    },
    {
      "source": "/api/send-email",
      "destination": "/api/email"
    },
    {
      "source": "/api/submissions",
      "destination": "/api/submissions"
    },
    {
      "source": "/api/profile",
      "destination": "/api/profile"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/process-delivery-jobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/maintenance",
      "schedule": "30 3 * * *"
    }
  ],
  "regions": [
    "iad1"
  ]
}
